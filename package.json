{
  "name": "@cprecioso/twice",
  "version": "0.1.0",
  "type": "module",
  "description": "Store and compare CI results between commits",
  "bugs": {
    "url": "https://github.com/cprecioso/twice/issues"
  },
  "author": {
    "name": "Carlos Precioso",
    "url": "https://github.com/cprecioso"
  },
  "packageManager": "yarn@4.18.0",
  "bin": "./dist/bin.mjs",
  "imports": {
    "#/package.json": "./package.json",
    "#/*": "./src/*.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    "./config": {
      "types": "./dist/config.d.mts",
      "default": "./dist/config.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@actions/attest": "^3.2.0",
    "@cprecioso/async-iterable-helpers": "^0.4.1",
    "@optique/core": "^1.2.5",
    "@optique/discover": "^1.2.5",
    "@optique/git": "^1.2.5",
    "@optique/run": "^1.2.5",
    "c12": "^4.0.0-rc.1",
    "execa": "^10.0.1",
    "gulp-tar": "^5.0.0",
    "std-env": "^4.2.0",
    "type-fest": "^5.9.0",
    "vinyl-fs": "^4.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@cprecioso/tsconfig": "^4.1.0",
    "@types/node": "^24.13.3",
    "@types/vinyl": "^2.0.12",
    "@types/vinyl-fs": "^3.0.8",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-pkg": "^0.22.1",
    "prettier-plugin-sh": "^0.19.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "sideEffects": false
}
